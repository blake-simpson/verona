# Verona environment variables — copy to .env (gitignored) and fill in.
# Most secrets are NOT here — they live in $VERONA_STATE_DIR/secrets/ with chmod 600.
# This file is for daemon-level config that is OK to be visible per-host.

# Where Verona keeps runtime state (memory, secrets, sessions, logs).
# Default: ~/.verona/state on Mac, /var/lib/verona/state on Linux.
# VERONA_STATE_DIR=

# Where YOUR (the user's) agent definitions live. Default ~/.verona/agents/.
# `verona agents init <name> --template <template>` scaffolds into this dir.
# Separate from the source repo's read-only `agents/examples/` and from
# $VERONA_STATE_DIR.
# VERONA_AGENTS_DIR=

# Daemon log level: error | warn | info | debug
# VERONA_LOG_LEVEL=info

# Used ONLY by the anthropic-api adapter, NOT by claude-cli.
# claude-cli adapter uses your Claude subscription (run `claude login` once).
# ANTHROPIC_API_KEY=

# Used by the openai adapter.
# OPENAI_API_KEY=

# Used by the openrouter adapter.
# OPENROUTER_API_KEY=

# Slack tokens are stored in $VERONA_STATE_DIR/secrets/_connectors/slack/
# via `verona connectors add slack`, NOT in this file.
