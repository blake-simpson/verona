# Verona daemon systemd user-mode template (Linux).
#
# Install path: ~/.config/systemd/user/verona-daemon.service
# Replace placeholders below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now verona-daemon.service
#   loginctl enable-linger $USER     # so it survives logout
#   journalctl --user -u verona-daemon -f
#
# Placeholders:
#   {{VERONA_RUNTIME}}   absolute path to the verona-runtime/ tree (e.g. /opt/verona/runtime)
#   {{VERONA_STATE_DIR}} absolute path to your state dir
#   {{NODE_BIN}}         absolute path to a Node 25.9+ binary
#   {{CLAUDE_BIN}}       absolute path to the `claude` CLI (e.g. ~/.local/bin/claude).
#                        systemd --user starts services with a sanitised PATH that
#                        rarely includes ~/.local/bin or fnm/nvm/volta version dirs,
#                        so we pin the binary explicitly via VERONA_CLAUDE_BIN.

[Unit]
Description=Verona agent daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{VERONA_RUNTIME}}
Environment=VERONA_STATE_DIR={{VERONA_STATE_DIR}}
Environment=VERONA_CLAUDE_BIN={{CLAUDE_BIN}}
ExecStart={{NODE_BIN}} {{VERONA_RUNTIME}}/dist/cli/index.js daemon
Restart=on-failure
RestartSec=10s

# Hardening — kept minimal so the unit works inside LXC/OpenVZ-style containers
# (common with cheap VPS providers). DON'T add the directives below without
# testing on the target host — they require namespace + capability operations
# the container manager may forbid, causing status=218/CAPABILITIES restart loops:
#   ProtectHostname=, CapabilityBoundingSet=, AmbientCapabilities=,
#   ProtectHome=, ProtectProc=, ProtectSystem=strict, BindReadOnlyPaths=,
#   PrivateUsers=, RestrictNamespaces=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
