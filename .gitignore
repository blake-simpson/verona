# dependencies
node_modules/

# build output
dist/
verona-runtime/
verona-runtime.tar.gz
*.tsbuildinfo

# state — never commit a deployed agent's runtime state
# anchored to repo root so we don't accidentally exclude src/state/ or tests/state/
/state/
.verona-state/

# secrets (state/secrets/ is already covered above)
.env
.env.*
!.env.example
*.local.toml
*.secret

# logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp

# test artifacts
coverage/
.vitest/
