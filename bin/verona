#!/usr/bin/env node
import("../dist/cli/index.js")
  .then(async ({ main }) => {
    const code = await main();
    process.exit(code ?? 0);
  })
  .catch((err) => {
    console.error("verona: failed to start —", err?.message ?? err);
    if (process.env.VERONA_DEBUG) console.error(err?.stack ?? "");
    console.error('  did you run `npm run build`? (or `npm run dev` for development)');
    process.exit(1);
  });
